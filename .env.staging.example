NODE_ENV=production
APP_ENV=staging
TZ=Europe/Kyiv
RELEASE_SHA=replace-with-git-sha

WEB_PORT=3000
WEB_HOST=staging.school.example
WEB_URL=https://staging.school.example
API_PORT=3001
API_HOST=api.staging.school.example
API_URL=https://api.staging.school.example
NEXT_PUBLIC_API_URL=https://api.staging.school.example/api
TLS_ACME_EMAIL=ops@school.example

POSTGRES_DB=school_staging
POSTGRES_USER=school_staging
POSTGRES_PASSWORD=replace-with-secret
DATABASE_URL=postgresql://school_staging:replace-with-secret@postgres:5432/school_staging
REDIS_URL=redis://redis:6379

SESSION_COOKIE_NAME=school_session
SESSION_TTL_DAYS=30
APP_ENCRYPTION_KEY=replace-with-32-plus-char-secret
MFA_ENCRYPTION_KEY=replace-with-32-plus-char-secret
RATE_LIMIT_HASH_KEY=replace-with-32-plus-char-secret
LOG_HASH_KEY=replace-with-32-plus-char-secret

STORAGE_DIR=/app/storage
WORKER_POLL_MS=30000
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120

CORS_ALLOWED_ORIGINS=https://staging.school.example
TRUST_PROXY_HOPS=1
STRICT_ORIGIN_CHECK_ENABLED=true
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-32-plus-char-secret
LOG_LEVEL=log

PAYMENT_PROVIDER=NONE
PAYMENT_DEFAULT_PROVIDER=NONE
LIQPAY_ENABLED=false
MONO_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

ERROR_REPORTING_WEBHOOK_URL=
ERROR_REPORTING_WEBHOOK_TOKEN=
ERROR_REPORTING_TIMEOUT_MS=1500

# Final beta acceptance — use only on a dedicated disposable/staging database.
# Never set these on production.
E2E_ALLOW_SEED=false
E2E_ALLOW_STAGING_SEED=false
E2E_ADMIN_EMAIL=e2e-admin@staging.school.example
E2E_ADMIN_PASSWORD=replace-with-staging-test-secret
E2E_MANAGER_EMAIL=e2e-manager@staging.school.example
E2E_MANAGER_PASSWORD=replace-with-staging-test-secret
E2E_TEACHER_EMAIL=e2e-teacher@staging.school.example
E2E_TEACHER_PASSWORD=replace-with-staging-test-secret
E2E_PARENT_EMAIL=e2e-parent@staging.school.example
E2E_PARENT_PASSWORD=replace-with-staging-test-secret
E2E_STUDENT_EMAIL=e2e-student@staging.school.example
E2E_STUDENT_PASSWORD=replace-with-staging-test-secret
ACCEPTANCE_REQUIRE_HTTPS=true
ACCEPTANCE_REQUIRE_BACKUP=true

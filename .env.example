NODE_ENV=development
APP_ENV=local
TZ=Europe/Kyiv

WEB_PORT=3000
WEB_URL=http://localhost:3000

API_PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=school_local
DATABASE_URL=postgresql://school:school_local@localhost:5432/school

REDIS_URL=redis://localhost:6379

SESSION_COOKIE_NAME=school_session
SESSION_TTL_DAYS=30

MFA_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY=

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
STORAGE_DIR=../../storage

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WORKER_POLL_MS=2000

EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Development seed users
SEED_ADMIN_EMAIL=admin@local.school
SEED_ADMIN_PASSWORD=change-me-admin
SEED_MANAGER_EMAIL=manager@local.school
SEED_MANAGER_PASSWORD=change-me-manager

# Optional local demo data
SEED_DEVELOPMENT_DATA=true
SEED_TEACHER_EMAIL=teacher@local.school
SEED_TEACHER_PASSWORD=change-me-teacher
SEED_TEACHER_RATE_60_MINOR=20000
SEED_MATH_PRICE_60_MINOR=40000
SEED_MATH_FIRST_LESSON_PRICE_MINOR=15000

# E2E beta-hardening identities (test databases only)
E2E_ALLOW_SEED=false
E2E_ADMIN_EMAIL=e2e-admin@local.school
E2E_ADMIN_PASSWORD=change-me-e2e-admin
E2E_MANAGER_EMAIL=e2e-manager@local.school
E2E_MANAGER_PASSWORD=change-me-e2e-manager
E2E_TEACHER_EMAIL=e2e-teacher@local.school
E2E_TEACHER_PASSWORD=change-me-e2e-teacher
E2E_PARENT_EMAIL=e2e-parent@local.school
E2E_PARENT_PASSWORD=change-me-e2e-parent
E2E_STUDENT_EMAIL=e2e-student@local.school
E2E_STUDENT_PASSWORD=change-me-e2e-student

# Online payments (Monobank acquiring + LiqPay API v7)
# PAYMENT_PROVIDER is kept for backward compatibility; prefer the multi-provider settings below.
PAYMENT_PROVIDER=NONE
PAYMENT_DEFAULT_PROVIDER=NONE
LIQPAY_ENABLED=false
MONO_ENABLED=false

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_CALLBACK_URL=http://localhost:3001/api/integrations/payments/liqpay/callback
LIQPAY_RESULT_URL=http://localhost:3000/parent/payments
LIQPAY_API_URL=https://www.liqpay.ua/api/request
LIQPAY_CHECKOUT_URL=https://www.liqpay.ua/api/3/checkout

MONO_TOKEN=
MONO_WEBHOOK_URL=http://localhost:3001/api/integrations/payments/mono/webhook
MONO_RESULT_URL=http://localhost:3000/parent/payments
MONO_API_URL=https://api.monobank.ua
# Optional cached base64-encoded PEM public key. If empty, API fetches /api/merchant/pubkey and caches it.
MONO_WEBHOOK_PUBLIC_KEY_BASE64=

# Production security / observability
# Comma-separated additional exact origins, without paths. WEB_URL is always included.
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0
STRICT_ORIGIN_CHECK_ENABLED=false
SECURITY_HEADERS_ENABLED=true

# Distributed PostgreSQL-backed protection for sensitive public endpoints.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_HASH_KEY=
RATE_LIMIT_LOGIN_IP_MAX=12
RATE_LIMIT_LOGIN_IDENTITY_MAX=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_MFA_IP_MAX=15
RATE_LIMIT_MFA_WINDOW_SECONDS=600
RATE_LIMIT_WEBHOOK_IP_MAX=180
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60

# Structured JSON logs. Hash key anonymizes client identifiers in logs.
LOG_LEVEL=log
LOG_HASH_KEY=

# Prometheus-compatible /api/metrics endpoint. Keep disabled or protect with a long bearer token.
METRICS_ENABLED=false
METRICS_TOKEN=

# Optional vendor-neutral error reporting webhook. Only redacted metadata is sent.
ERROR_REPORTING_WEBHOOK_URL=
ERROR_REPORTING_WEBHOOK_TOKEN=
ERROR_REPORTING_TIMEOUT_MS=1500

# Release identity / background-service staging checks
RELEASE_SHA=local
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120

# v32 staging/RC E2E safety
E2E_ALLOW_STAGING_SEED=false

# v32 final beta acceptance (staging/RC only)
ACCEPTANCE_REQUIRE_HTTPS=false
ACCEPTANCE_REQUIRE_BACKUP=true
ACCEPTANCE_BACKUP_FILE=
ACCEPTANCE_EVIDENCE_DIR=artifacts/acceptance
ACCEPTANCE_REPORT=artifacts/beta-acceptance-report.json

# v33 release/staging tooling (CLI-only; not application runtime secrets)
STAGING_ENV_FILE=.env.staging
STAGING_ACCEPTANCE_MODE=false
# Optional comma-separated image tags for `pnpm release:images:evidence`; defaults to school-api/worker/web:<RELEASE_SHA>.
RELEASE_IMAGES=
